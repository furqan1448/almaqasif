/**
 * MenuSync.gs — تحديث قائمة المقصف فورًا عند التعديل المباشر في Google Sheets
 *
 * نظام المقاصف يحفظ نسخة مؤقتة من «قائمة الأسعار» لمدة ١٥ دقيقة لتسريع الموقع.
 * التعديل من داخل الموقع يمسح هذه النسخة فورًا، أما التعديل اليدوي في الشيت فكان يظهر بعد ١٥ دقيقة.
 * هذه الدالة تعمل تلقائيًا عند أي تعديل يدوي في ورقة «قائمة الأسعار»، فيظهر التعديل في القائمة خلال دقيقة.
 *
 * طريقة الإضافة (مرة واحدة فقط):
 *  1) افتحي مشروع Apps Script الخاص بنظام المقاصف (المرتبط بالشيت).
 *  2) اضغطي «+» بجانب «الملفات» ← «نص برمجي»، وسمّيه MenuSync.
 *  3) الصقي هذا الملف كاملًا، ثم احفظي.
 *  لا يحتاج إلى نشر جديد ولا إلى تعديل Code.gs.
 */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    if (e.range.getSheet().getName() !== 'قائمة الأسعار') return;
    if (typeof invalidateCache_ === 'function') invalidateCache_('قائمة الأسعار');
  } catch (err) {}
}
